// Three independent readiness cells. No external participants or events are inferred.
contract V4Launch(byte[32] initialWorldId, byte[32] initialOwner, byte[32] initialBeneficiary, int initialMember, bool initialReady, int initialMaxFee) {
    byte[32] worldId = initialWorldId;
    byte[32] owner = initialOwner;
    byte[32] beneficiary = initialBeneficiary;
    int member = initialMember;
    bool ready = initialReady;
    int maxFee = initialMaxFee;

    #[covenant(binding = cov, from = 3, to = 1)]
    function move(State[] prevStates, State[] newStates, int operation, sig authorization) {
        require(checkSig(authorization, pubkey(owner)));
        require(maxFee > 0 && maxFee <= 3000000);
        require(member >= 0 && member <= 2);
        require(tx.inputs.length == prevStates.length);
        int total = 0;
        byte[32] covId = OpInputCovenantId(this.activeInputIndex);
        for(i, 0, prevStates.length, 3) {
            require(OpCovInputIdx(covId, i) == i);
            require(prevStates[i].worldId == worldId);
            require(prevStates[i].beneficiary == beneficiary && prevStates[i].maxFee == maxFee);
            total = total + tx.inputs[i].value;
        }
        require(tx.outputs.length == 1);
        int fee = total - tx.outputs[0].value;
        require(fee > 0 && fee <= maxFee && tx.outputs[0].value > 0);
        if(operation == 0) {
            require(prevStates.length == 1 && newStates.length == 1 && !ready);
            require(newStates[0].worldId == worldId);
            require(newStates[0].owner == owner && newStates[0].member == member);
            require(newStates[0].beneficiary == beneficiary && newStates[0].maxFee == maxFee);
            require(newStates[0].ready);
        } else if(operation == 2) {
            require(prevStates.length == 1 && newStates.length == 0);
            byte[36] cancellation = new ScriptPubKeyP2PK(pubkey(owner));
            require(tx.outputs[0].scriptPubKey == byte[](cancellation));
        } else {
            require(operation == 1 && prevStates.length == 3 && newStates.length == 0);
            for(i, 0, 3, 3) { require(prevStates[i].member == i && prevStates[i].ready); }
            require(prevStates[0].owner != prevStates[1].owner && prevStates[0].owner != prevStates[2].owner && prevStates[1].owner != prevStates[2].owner);
            byte[36] destination = new ScriptPubKeyP2PK(pubkey(beneficiary));
            require(tx.outputs[0].scriptPubKey == byte[](destination));
        }
    }
    #[covenant.delegate]
    function authorizeDelegate(sig authorization) { require(checkSig(authorization, pubkey(owner))); }
}
